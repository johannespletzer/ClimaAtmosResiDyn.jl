# The site's values for the skills' job scripts. Copy this file to
# ~/.config/climaatmos-fork/site.env, or point CLIMA_SITE_ENV at the copy, and
# fill in the values. Keep the copy out of every repository.
export SBATCH_ACCOUNT=<Slurm account>                # read by sbatch itself
export SBATCH_PARTITION=<short partition, at most 2 h>
export CLIMA_PARTITION_LONG=<partition for longer jobs>
export CLIMA_JULIA_DEPOT=<shared Julia depot>
