# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# outputs
test/output_validation
test/callbacks_tests
output/

# System-specific files and directories generated by the BinaryProvider and BinDeps packages
# They contain absolute paths specific to the host computer, and so should not be committed
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Build artifacts for creating documentation generated by the Documenter package
# and running docs/make.jl
docs/build/
docs/site/
docs/src/configuration_options.md

/Manifest*.toml
# docs, test
*/Manifest*.toml
.buildkite/PrecompileCI/Manifest*.toml
calibration/test/Manifest*.toml

# Generated artifact declarations. The two that are checked in are source.
Artifacts.toml
!/Artifacts.toml
!calibration/experiments/*/Artifacts.toml

# ignore vscode and macos artifacts
.vscode/
*.DS

# ignore simulation outputs
*.json
*.in
# ...except the coupler config templates, which are source files. They end
# in .in because the chaining script substitutes into them before each run.
!config/coupler_configs/*.yml.in
*.vtu
*.nc
*.mp4
*.png
# ...except documentation assets, which are source files.
!docs/src/assets/*.png
*.hdf5
*.h5
*.g
*.lock
*.loc
*.out
*.log

# misc
.DS_Store
.qodo
MEMORY.md
.agents
# Claude Code worktrees
.claude/worktrees/

# Python bytecode from the .dev/ helper scripts
__pycache__/
*.pyc
