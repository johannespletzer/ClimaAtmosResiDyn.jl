#!/usr/bin/env bash
#SBATCH --job-name=strat-tracers-amip
#SBATCH -o ./strat-tracers-amip-%j.out
#SBATCH -e ./strat-tracers-amip-%j.err
#SBATCH --partition=compute
#SBATCH --ntasks-per-node=128
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --nodes=4
#SBATCH --account=bd1062
#SBATCH --time=08:00:00

# -----------------------------------------------------------------------------
# One segment of the coupled AMIP stratospheric tracer campaign, and the
# resubmission that continues it.
#
#   sbatch --export=ALL,MEMBER=a runscripts/xmodel.amip
#
# The campaign runs 1979-01-01 to 2021-01-01 in segments that each end on a
# checkpoint boundary, so a segment finishes on its own inside the queue slot.
# A segment killed at the wall-time limit costs twice over. It discards
# everything since the last checkpoint, and it stops the chain, because SLURM
# tears down this script along with the job step and nothing after `srun`
# runs.
#
# Each segment computes its own end from the newest checkpoint, so the same
# command starts the campaign and continues it. To restart from scratch, delete
# the output directory.
# -----------------------------------------------------------------------------

source /sw/etc/profile.levante
set -euo pipefail

module purge
module load gcc/11.2.0-gcc-11.2.0
module load openmpi/4.1.2-gcc-11.2.0

# -----------------------------------------------------------------------------
# Settings. Every one may be overridden from the environment.
# -----------------------------------------------------------------------------

MEMBER="${MEMBER:?set MEMBER=a or MEMBER=b}"
case "${MEMBER}" in
    a|b) ;;
    *) echo "ERROR: MEMBER must be 'a' or 'b', got '${MEMBER}'"; exit 1 ;;
esac

# Use the submission directory. SLURM copies the batch script into its spool
# directory before running it, so ${BASH_SOURCE[0]} names that copy rather than
# the file in the repository, which rules it out for locating the repo and for
# resubmitting.
ROOT="${ROOT:-${SLURM_SUBMIT_DIR:-${PWD}}}"
SCRIPT_PATH="${ROOT}/runscripts/xmodel.amip"
COUPLER="${COUPLER:?set COUPLER to the ClimaCoupler.jl checkout}"
JULIA="${JULIA:-$(command -v julia || true)}"
JULIA_CHANNEL="${JULIA_CHANNEL:-+1.11}"
JULIA_DEPOT_PATH="${JULIA_DEPOT_PATH:-${HOME}/.julia/depots/levante-amip}"
export JULIA_DEPOT_PATH
SRUN_MPI="${SRUN_MPI:-pmix_v3}"

# Where the coupler writes. `coupler_output_dir` in the config must match, and
# the job_id (taken from the rendered config's basename) is appended to it.
COUPLER_OUTPUT_DIR="${COUPLER_OUTPUT_DIR:-${ROOT}/output}"
JOB_ID="strat_tracers_amip_${MEMBER}"
BASE_DIR="${COUPLER_OUTPUT_DIR}/${JOB_ID}"

# 1979-01-01 -> 2021-01-01 is 15341 days (42*365 + 11 leap days).
CAMPAIGN_DAYS="${CAMPAIGN_DAYS:-15341}"
# Simulated days per job. Keep it a whole number of checkpoint intervals, so
# every segment ends exactly on a checkpoint. Size it from the measured sypd of
# the calibration run to fit inside the wall-time limit with an hour to spare.
# The default errs on the low side.
SEGMENT_DAYS="${SEGMENT_DAYS:-150}"
CHECKPOINT_DAYS="${CHECKPOINT_DAYS:-30}"   # must equal checkpoint_dt in the config

DAY=86400
CAMPAIGN_END=$(( CAMPAIGN_DAYS * DAY ))
SEGMENT_SECONDS=$(( SEGMENT_DAYS * DAY ))
CHECKPOINT_SECONDS=$(( CHECKPOINT_DAYS * DAY ))

if (( SEGMENT_DAYS % CHECKPOINT_DAYS != 0 )); then
    echo "ERROR: SEGMENT_DAYS (${SEGMENT_DAYS}) must be a multiple of CHECKPOINT_DAYS (${CHECKPOINT_DAYS}),"
    echo "       or segments would not end on a checkpoint and each restart would redo work."
    exit 1
fi

TEMPLATE="${ROOT}/config/coupler_configs/${JOB_ID}.yml.in"
ATMOS_CONFIG="${ROOT}/config/example_configs/strat_tracers_transient_${MEMBER}.yml"
RUN_CONFIG_DIR="${BASE_DIR}/run_configs"
# The basename decides job_id, and job_id decides BASE_DIR. Keep it fixed.
RUN_CONFIG="${RUN_CONFIG_DIR}/${JOB_ID}.yml"

for f in "${TEMPLATE}" "${ATMOS_CONFIG}"; do
    [[ -f "${f}" ]] || { echo "ERROR: missing ${f}"; exit 1; }
done
[[ -f "${COUPLER}/experiments/AMIP/run_simulation.jl" ]] || {
    echo "ERROR: no AMIP driver under COUPLER=${COUPLER}"; exit 1; }
[[ -n "${JULIA}" && -x "${JULIA}" ]] || { echo "ERROR: julia not found; set JULIA"; exit 1; }
[[ -d "${JULIA_DEPOT_PATH}" ]] || {
    echo "ERROR: depot ${JULIA_DEPOT_PATH} not found. Build the AMIP stack on a login node first."; exit 1; }
# Checked here because the failure is otherwise silent. The segment would run
# to completion, and only then would the resubmission fail to find the script.
[[ -f "${SCRIPT_PATH}" ]] || {
    echo "ERROR: cannot find this script at ${SCRIPT_PATH}."
    echo "       Submit from the repository root, or set ROOT explicitly:"
    echo "         ROOT=/path/to/ClimaAtmosResiDyn.jl sbatch --export=ALL,MEMBER=a runscripts/xmodel.amip"
    exit 1; }

# -----------------------------------------------------------------------------
# Where the last segment stopped
#
# The coupler names checkpoints `checkpoint_<model>_<t>.hdf5`, with t in whole
# seconds, and keeps them in <base>/checkpoints. That sits outside the numbered
# output_XXXX directories, so they gather in one place across segments.
# -----------------------------------------------------------------------------

restart_t=0
if [[ -d "${BASE_DIR}/checkpoints" ]]; then
    newest=$(find "${BASE_DIR}/checkpoints" -maxdepth 1 -name 'checkpoint_*_*.hdf5' -printf '%f\n' 2>/dev/null \
             | sed -n 's/^checkpoint_.*_\([0-9]\{1,\}\)\.hdf5$/\1/p' \
             | sort -n | tail -n 1)
    [[ -n "${newest}" ]] && restart_t="${newest}"
fi

if (( restart_t >= CAMPAIGN_END )); then
    echo "Campaign complete for member ${MEMBER}: newest checkpoint at ${restart_t}s >= ${CAMPAIGN_END}s."
    exit 0
fi

segment_end=$(( restart_t + SEGMENT_SECONDS ))
if (( segment_end > CAMPAIGN_END )); then
    segment_end=${CAMPAIGN_END}
fi

echo "================================================================"
echo "Coupled AMIP stratospheric tracers -- member ${MEMBER}"
echo "================================================================"
echo "SLURM job:       ${SLURM_JOB_ID:-<none>} on ${SLURM_JOB_NUM_NODES:-?} node(s)"
echo "Coupler:         ${COUPLER}"
echo "Atmos config:    ${ATMOS_CONFIG}"
echo "Output base:     ${BASE_DIR}"
echo "Resuming from:   ${restart_t}s ($(( restart_t / DAY )) days)"
echo "Segment ends at: ${segment_end}s ($(( segment_end / DAY )) days) of ${CAMPAIGN_END}s"
echo "Start time:      $(date --iso-8601=seconds)"
echo

# -----------------------------------------------------------------------------
# Render the config for this segment
# -----------------------------------------------------------------------------

mkdir -p "${RUN_CONFIG_DIR}"
sed -e "s|@ATMOS_CONFIG_FILE@|${ATMOS_CONFIG}|g" \
    -e "s|@T_END_SECONDS@|${segment_end}|g" \
    "${TEMPLATE}" > "${RUN_CONFIG}"

if grep -q '@[A-Z_]*@' "${RUN_CONFIG}"; then
    echo "ERROR: unsubstituted placeholders remain in ${RUN_CONFIG}:"
    grep -n '@[A-Z_]*@' "${RUN_CONFIG}"
    exit 1
fi

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------

export JULIA_NUM_THREADS=1
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export CLIMACOMMS_DEVICE=CPU
export CLIMACOMMS_CONTEXT=MPI

unset I_MPI_HYDRA_BOOTSTRAP I_MPI_HYDRA_BOOTSTRAP_EXEC_EXTRA_ARGS || true
unset I_MPI_PMI I_MPI_PMI_LIBRARY UCX_MEMTYPE_CACHE UCX_ERROR_SIGNALS || true

export OMPI_MCA_osc=ucx
export OMPI_MCA_pml=ucx
export OMPI_MCA_btl=self
export UCX_HANDLE_ERRORS=bt
export OMPI_MCA_pml_ucx_opal_mem_hooks=1

# Warm the precompile cache serially: under srun every rank would otherwise race
# for the same cache files, which is slow and can time out on a shared
# filesystem.
echo "Warming precompilation cache:"
"${JULIA}" ${JULIA_CHANNEL:+"${JULIA_CHANNEL}"} \
    --project="${COUPLER}/experiments/AMIP" --startup-file=no \
    -e 'using ClimaCoupler, ClimaAtmos; println("ClimaCoupler and ClimaAtmos loaded")'
echo

# -----------------------------------------------------------------------------
# Run this segment
# -----------------------------------------------------------------------------

cd "${ROOT}"

set +e
srun --mpi="${SRUN_MPI}" --label --cpu_bind=verbose --hint=nomultithread \
     --distribution=block:cyclic \
     "${JULIA}" ${JULIA_CHANNEL:+"${JULIA_CHANNEL}"} \
        --project="${COUPLER}/experiments/AMIP" --startup-file=no \
        "${COUPLER}/experiments/AMIP/run_simulation.jl" \
        --config_file "${RUN_CONFIG}"
status=$?
set -e

echo
echo "Segment exit status: ${status}"
echo "End time:            $(date --iso-8601=seconds)"

if (( status != 0 )); then
    echo "Segment failed; not resubmitting. Fix the cause, then sbatch again to resume"
    echo "from the newest checkpoint under ${BASE_DIR}/checkpoints."
    exit "${status}"
fi

if (( segment_end >= CAMPAIGN_END )); then
    echo "Campaign complete for member ${MEMBER}."
    exit 0
fi

echo "Resubmitting to continue from ${segment_end}s."
sbatch --export=ALL,MEMBER="${MEMBER}" "${SCRIPT_PATH}"
