# terrabyte software stacks: the single source of truth for the pairing of
# compiler module, MPI module and Julia depot.
#
# setup-julia-terrabyte.tcsh builds a depot against one of these stacks. It
# writes an artifacts/Overrides.toml repointing OpenMPI_jll at that MPI, and an
# MPIPreferences libmpi pointing into it. A runscript that loads some other MPI
# ends up with two incompatible Open MPI builds in one process.
#
# This mirrors runscripts/levante_stacks.env. Read that file's header for the
# reasoning the two machines share.
#
# FORMAT: plain KEY=VALUE, one per line, no quoting, no substitution, no shell
# syntax. bash sources this file and tcsh parses it with sed. Keep it that way.
# A `${...}` or a command substitution would be read literally by one side and
# expanded by the other.

# Depot root. Absolute here, unlike Levante's $HOME-relative path, because $HOME
# on terrabyte is for code and configs only. A depot holds packages, artifacts
# and the precompile cache and runs to several GB, so it belongs on scratch.
# Nothing on scratch is durable; treat a depot as rebuildable by re-running the
# setup script. Set TERRABYTE_DEPOT_ROOT in the environment to override.
TERRABYTE_DEPOT_ROOT_ABSOLUTE=/dss/dsstbyfs02/scratch/0D/di38kez/julia-depots

# CPU stack. openmpi/4.1.8-gcc13 is the default openmpi module. Its libmpi.so.40
# has the same soname as the OpenMPI_jll artifact, so the Overrides.toml swap is
# an ABI match and no exact version agreement is needed.
TERRABYTE_CPU_COMPILER_MODULE=gcc/13.2.0
TERRABYTE_CPU_MPI_MODULE=openmpi/4.1.8-gcc13
TERRABYTE_CPU_DEPOT_NAME=terrabyte-cpu

# The srun PMI plugin, measured with a 2-rank job on hpda2_test.
#
# pmi2 does NOT work. This Open MPI is configured --with-pmix and has no usable
# PMI-2 path, so MPI_Init aborts with "requires that you configure and build
# SLURM --with-pmix". pmix does work: the client's external PMIx 5.0.3 talks to
# Slurm's pmix_v6 server without trouble.
TERRABYTE_CPU_SRUN_MPI=pmix

# Two MCA settings keep the PMIx startup noise out of run logs. Neither changes
# behaviour: without them every rank prints a "psec / munge component not
# found" block and two ignored mca_pmix_s1/s2 open failures, and the job still
# runs. The setup script prints these alongside the srun line.
#
#   setenv PMIX_MCA_psec native
#   setenv OMPI_MCA_pmix  ext3x

# GPU stack. Identified but NOT verified: nothing has run on a GPU node yet, and
# the CUDA toolkit pin still needs a driver version measured there. The modules
# below are recorded so the next pass does not have to re-derive them.
#
# nvhpc/24.9 is both compiler and MPI. It puts its own comm_libs/mpi/bin on
# PATH, which resolves to an Open MPI 4.1.5 built --with-cuda, at
#   .../nvhpc/24.9-gcc-geugw7j/Linux_x86_64/24.9/comm_libs/12.6/openmpi4/openmpi-4.1.5
# That is the same shape as Levante's GPU stack, which pairs nvhpc/24.7 with the
# Open MPI 4.1.5 under comm_libs/12.5. The spack openmpi modules are built
# --without-cuda and cannot serve a GPU stack.
#
# The GPU partitions are hpda2_compute_gpu (46 nodes, gpu:4) and hpda2_testgpu
# (2 nodes). They report no node features, so a CUDA probe job takes no
# --constraint, unlike Levante's a100_80.
#
# TERRABYTE_GPU_COMPILER_MODULE=nvhpc/24.9
# TERRABYTE_GPU_MPI_MODULE=nvhpc/24.9
# TERRABYTE_GPU_DEPOT_NAME=terrabyte-gpu
# TERRABYTE_GPU_SRUN_MPI=pmi2
# TERRABYTE_GPU_PROBE_ACCOUNT=hpda-c
# TERRABYTE_GPU_PROBE_PARTITION=hpda2_testgpu
