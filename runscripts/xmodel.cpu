#!/usr/bin/env bash
#SBATCH --job-name=passive-tracers
#SBATCH -o ./passive-tracers-%j.out
#SBATCH -e ./passive-tracers-%j.err
#SBATCH --no-requeue

#SBATCH --partition=compute
#SBATCH --ntasks-per-node=32
#SBATCH --exclusive
#SBATCH --mem=0

#SBATCH --nodes=1
#SBATCH --account=bd1062
#SBATCH --time=01:00:00
#SBATCH --mail-type=FAIL

# -----------------------------------------------------------------------------
# Levante software environment
#
# Sourced before `set -u`: site profiles routinely reference unset variables,
# which would abort the job at source time.
# -----------------------------------------------------------------------------

source /sw/etc/profile.levante

set -euo pipefail

module purge
module load gcc/11.2.0-gcc-11.2.0
module load openmpi/4.1.2-gcc-11.2.0

# -----------------------------------------------------------------------------
# Paths
#
# Each may be overridden from the environment, e.g.
#   SCRIPT=experiments/my_run.jl sbatch runscripts/xmodel.cpu
# ROOT defaults to the repository containing this script, so a clone in a
# different location needs no edits.
# -----------------------------------------------------------------------------

ROOT="${ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
PROJECT="${PROJECT:-${ROOT}/.buildkite}"
SCRIPT="${SCRIPT:-${ROOT}/experiments/passive_stratospheric_tracers.jl}"
JULIA="${JULIA:-$(command -v julia || true)}"

# juliaup channel to run, e.g. "+1.11". Set JULIA_CHANNEL="" to use whatever
# `julia` resolves to (the version check below still applies).
JULIA_CHANNEL="${JULIA_CHANNEL:-+1.11}"

# -----------------------------------------------------------------------------
# Validate required files
# -----------------------------------------------------------------------------

if [[ -z "${JULIA}" || ! -x "${JULIA}" ]]; then
    echo "ERROR: Julia executable not found:"
    echo "  '${JULIA}'"
    echo "Set JULIA=/path/to/julia."
    exit 1
fi

if [[ ! -f "${PROJECT}/Project.toml" ]]; then
    echo "ERROR: Julia project not found:"
    echo "  ${PROJECT}/Project.toml"
    exit 1
fi

if [[ ! -f "${SCRIPT}" ]]; then
    echo "ERROR: Experiment script not found:"
    echo "  ${SCRIPT}"
    echo "Set SCRIPT=/path/to/experiment.jl."
    exit 1
fi

# -----------------------------------------------------------------------------
# Julia version must match the pinned manifest
#
# `.buildkite` pins dependencies per Julia minor version
# (Manifest-v<major>.<minor>.toml). Running a different minor version silently
# ignores that manifest and re-resolves the dependency graph, which can select
# package versions the source does not support. The failure then surfaces deep
# inside the run -- typically as a MethodError while the configuration is being
# built -- after the job has already been queued and started. Fail here instead.
# -----------------------------------------------------------------------------

manifest="$(ls "${PROJECT}"/Manifest-v*.toml 2>/dev/null | head -n 1 || true)"

if [[ -n "${manifest}" ]]; then
    expected_version="$(basename "${manifest}")"
    expected_version="${expected_version#Manifest-v}"
    expected_version="${expected_version%.toml}"

    actual_version="$(
        "${JULIA}" ${JULIA_CHANNEL:+"${JULIA_CHANNEL}"} --startup-file=no \
            -e 'print(VERSION.major, ".", VERSION.minor)'
    )"

    if [[ "${actual_version}" != "${expected_version}" ]]; then
        echo "ERROR: Julia version does not match the pinned manifest."
        echo "  manifest expects: ${expected_version} ($(basename "${manifest}"))"
        echo "  julia provides:   ${actual_version}"
        echo
        echo "Install the matching version (e.g. 'juliaup add ${expected_version}')"
        echo "or set JULIA_CHANNEL=+${expected_version}."
        exit 1
    fi
fi

# -----------------------------------------------------------------------------
# Threading and ClimaComms
# -----------------------------------------------------------------------------

# One Julia process per physical core. Prevent nested threading.
export JULIA_NUM_THREADS=1
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

export CLIMACOMMS_DEVICE=CPU
export CLIMACOMMS_CONTEXT=MPI

# -----------------------------------------------------------------------------
# Remove incompatible inherited settings
# -----------------------------------------------------------------------------

unset I_MPI_HYDRA_BOOTSTRAP || true
unset I_MPI_HYDRA_BOOTSTRAP_EXEC_EXTRA_ARGS || true
unset I_MPI_PMI || true
unset I_MPI_PMI_LIBRARY || true

unset UCX_MEMTYPE_CACHE || true
unset UCX_ERROR_SIGNALS || true

# -----------------------------------------------------------------------------
# Open MPI and UCX settings tested on Levante
# -----------------------------------------------------------------------------

export OMPI_MCA_osc=ucx
export OMPI_MCA_pml=ucx
export OMPI_MCA_btl=self
export UCX_HANDLE_ERRORS=bt
export OMPI_MCA_pml_ucx_opal_mem_hooks=1

# -----------------------------------------------------------------------------
# Job information
# -----------------------------------------------------------------------------

echo "================================================================"
echo "Passive tracer ClimaAtmos run"
echo "================================================================"
echo "Job ID:          ${SLURM_JOB_ID}"
echo "Job name:        ${SLURM_JOB_NAME}"
echo "Node list:       ${SLURM_JOB_NODELIST}"
echo "Nodes:           ${SLURM_JOB_NUM_NODES}"
echo "MPI ranks:       ${SLURM_NTASKS}"
echo "Tasks per node:  ${SLURM_TASKS_PER_NODE}"
echo "CPUs per task:   ${SLURM_CPUS_PER_TASK:-1}"
echo "Working path:    ${ROOT}"
echo "Julia:           ${JULIA} ${JULIA_CHANNEL}"
echo "Project:         ${PROJECT}"
echo "Experiment:      ${SCRIPT}"
echo "Start time:      $(date --iso-8601=seconds)"
echo

echo "Loaded modules:"
module list 2>&1
echo

echo "Julia version:"
"${JULIA}" ${JULIA_CHANNEL:+"${JULIA_CHANNEL}"} --version
echo

# -----------------------------------------------------------------------------
# Verify MPI configuration before launching all ranks
# -----------------------------------------------------------------------------

echo "MPI.jl configuration:"

"${JULIA}" ${JULIA_CHANNEL:+"${JULIA_CHANNEL}"} \
    --project="${PROJECT}" \
    --startup-file=no \
    -e '
        using MPI

        implementation, version = MPI.identify_implementation()

        println("Implementation: ", implementation)
        println("Version:        ", version)
        println("Library:        ", MPI.libmpi)

        implementation == "OpenMPI" ||
            error("Expected OpenMPI, found $implementation")
    '

echo

# -----------------------------------------------------------------------------
# Run the experiment
#
# `set -e` is lifted around srun so that the exit status is reported and the
# end time is logged even when the run fails.
# -----------------------------------------------------------------------------

cd "${ROOT}"

echo "Launching passive tracer experiment..."
echo

set +e
srun \
    --label \
    --cpu_bind=verbose \
    --hint=nomultithread \
    --distribution=block:cyclic \
    "${JULIA}" ${JULIA_CHANNEL:+"${JULIA_CHANNEL}"} \
        --project="${PROJECT}" \
        --startup-file=no \
        "${SCRIPT}"
status=$?
set -e

echo
echo "Experiment exit status: ${status}"
echo "End time:               $(date --iso-8601=seconds)"

exit "${status}"
