# Levante software stacks: the single source of truth for the pairing of
# compiler module, MPI module and Julia depot.
#
# setup-julia-levante.tcsh builds a depot against one of these stacks. It writes
# an artifacts/Overrides.toml repointing OpenMPI_jll at that MPI, and an
# MPIPreferences libmpi pointing into it. A runscript that loads some other MPI
# ends up with two incompatible Open MPI builds in one process. The usual
# symptom is
#
#   libopen-pal.so.80: undefined symbol: pmix_framework_names
#
# though it can also run through and quietly take a staged host path in place of
# GPU-direct. The setup script and the runscripts both read this file, so the
# pairing changes in one place.
#
# FORMAT: plain KEY=VALUE, one per line, no quoting, no substitution, no shell
# syntax. bash sources this file and tcsh parses it with sed. Keep it that way.
# A `${...}` or a command substitution would be read literally by one side and
# expanded by the other.

# Depot root, relative to $HOME. Each stack gets its own depot below this, a
# full copy of packages, artifacts and precompile cache running to several GB.
# Under a tight $HOME quota, set LEVANTE_DEPOT_ROOT in the environment to an
# absolute path on work or scratch. Both consumers prefer it when set.
LEVANTE_DEPOT_ROOT_RELATIVE_TO_HOME=.julia/depots

# CPU stack.
LEVANTE_CPU_COMPILER_MODULE=gcc/11.2.0-gcc-11.2.0
LEVANTE_CPU_MPI_MODULE=openmpi/4.1.2-gcc-11.2.0
LEVANTE_CPU_DEPOT_NAME=levante-cpu
LEVANTE_CPU_SRUN_MPI=pmix_v3

# GPU stack. Open MPI 4.1.5 is built against nvhpc 24.7 and is the one the GPU
# depot's OpenMPI_jll override points at.
LEVANTE_GPU_COMPILER_MODULE=nvhpc/24.7-gcc-11.2.0
LEVANTE_GPU_MPI_MODULE=openmpi/4.1.5-nvhpc-24.7
LEVANTE_GPU_DEPOT_NAME=levante-gpu
LEVANTE_GPU_SRUN_MPI=pmix_v3
